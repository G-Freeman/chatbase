{
	"name": "personal",
	"private": true,
	"pnpm": {
		"overrides": {
			"esbuild": "0.25.11"
		}
	},
	"workspaces": ["front", "types", "generators", "docs", "api"],
	"scripts": {
		"front:start": "pnpm --dir packages/front dev",
		"docs:start": "pnpm exec vite --config packages/docs/vite.config.ts",
		"docs:gen": "pnpm exec ts-node packages/generators/gen.ts",
		"ai:codex": "codex -a never -s workspace-write"
	},
	"devDependencies": {
		"@types/node": "^24.7.2",
		"esbuild": "0.25.11",
		"ts-node": "^10.9.1",
		"typescript": "^5.0.0",
		"vite": "^5.0.0"
	}
}
