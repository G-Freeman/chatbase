{
  "openapi": "3.1.0",
  "info": {
    "title": "Betting API (HTTP)",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.paryajpam.com/api/"
    }
  ],
  "paths": {
    "/auth/": {
      "post": {
        "operationId": "auth",
        "summary": "Auth",
        "description": "Auth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "number"
                  },
                  "locale": {
                    "type": "string"
                  },
                  "partner": {
                    "type": "string"
                  },
                  "tz": {
                    "type": "number"
                  }
                },
                "required": [
                  "key",
                  "locale",
                  "partner",
                  "tz"
                ]
              }
            }
          }
        },
        "tags": [
          "Auth"
        ]
      }
    },
    "/user/{id}": {
      "get": {
        "operationId": "getUser",
        "summary": "Get user",
        "description": "Get user",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          }
        },
        "tags": [
          "User"
        ]
      }
    },
    "/user/{userId}": {
      "post": {
        "operationId": "setUser",
        "summary": "Set user",
        "description": "Set user",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/User"
              }
            }
          }
        },
        "tags": [
          "User"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "Message": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "ts": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "from",
          "text",
          "ts"
        ]
      }
    }
  }
}